# .gitignore for the Go project openapi-swagger

/dist/

# ------------------------------------------------
# Go language specific ignores
# ------------------------------------------------

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Build output
bin/
dist/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local

# Debug files
__debug_bin*
